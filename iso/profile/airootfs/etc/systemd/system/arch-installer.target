# Live-medium services.
#
# tty1 runs the installer (autologin), tty2 gives a root shell, and networking
# is up before the window opens so mirrors can be reached immediately.
[Unit]
Description=Arch Linux installer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
